<% layout('layouts/boilerplate') %>

<div class="container mx-auto px-4 py-8">
    <!-- Top Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <!-- Trust Score Card -->
        <div class="bg-slate-900 p-6 rounded-2xl border border-indigo-500/30">
            <h3 class="text-slate-400 text-sm mb-2">Manipulation Resistance (Trust)</h3>
            <div class="flex items-end gap-2">
                <span class="text-4xl font-mono text-indigo-400"><%= user.trustScore %></span>
                <span class="text-slate-500 pb-1">%</span>
            </div>
            <div class="w-full bg-slate-800 h-2 mt-4 rounded-full overflow-hidden">
                <div class="bg-indigo-500 h-full" style="width: <%= user.trustScore %>%"></div>
            </div>
        </div>

        <!-- Earnings Card -->
        <div class="bg-slate-900 p-6 rounded-2xl border border-emerald-500/30">
            <h3 class="text-slate-400 text-sm mb-2">Available Balance</h3>
            <p class="text-4xl font-mono text-emerald-400">₹<%= user.walletBalance.toLocaleString() %></p>
            <button class="mt-4 text-xs text-emerald-500 hover:underline">Withdraw Funds →</button>
        </div>
    </div>

    <!-- Project Section -->
    <section class="bg-slate-900 rounded-3xl p-8 border border-slate-800">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-xl font-bold text-white">Your Registered Projects</h2>
            <!-- Ensure you have a script for toggleModal() -->
            <button onclick="toggleModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2 rounded-lg text-sm transition-colors">
                Add New Project
            </button>
        </div>

        <% if(projects && projects.length > 0) { %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <% for(let p of projects) { %>
                    <div class="p-6 bg-slate-800/50 rounded-2xl border <%= p.status === 'flagged' ? 'border-red-500/50' : 'border-slate-700' %> transition-all">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-white font-bold text-lg"><%= p.title %></h3>
                                <p class="text-slate-400 text-xs truncate max-w-[200px] mb-2"><%= p.link %></p>
                                <p class="text-xs">
                                    <span class="text-slate-500">Status:</span>
                                    <span class="<%= p.status === 'flagged' ? 'text-red-400' : 'text-emerald-400' %> uppercase font-bold tracking-tighter">
                                        <%= p.status %>
                                    </span>
                                </p>
                            </div>

                            <% if(p.status === 'flagged') { %>
                                <div class="bg-red-500/10 text-red-500 text-[10px] px-2 py-1 rounded border border-red-500/20 animate-pulse">
                                    ANOMALY DETECTED
                                </div>
                            <% } %>
                        </div>

                        <!-- Current Stats Display (MVP Helper) -->
                        <div class="flex gap-4 mb-4 text-[10px] text-slate-400 font-mono">
                            <span>VIEWS: <%= p.views %></span>
                            <span>LIKES: <%= p.likes %></span>
                        </div>

                        <!-- Simulation Trigger: Must stay INSIDE the loop to use p._id -->
                        <div class="bg-slate-900/50 p-4 rounded-xl border border-slate-700/50">
                            <p class="text-[10px] text-slate-500 mb-3 uppercase tracking-widest">MVP Demo: Push Engagement</p>
                            <form action="/creator/project/<%= p._id %>/simulate" method="POST" class="flex gap-2">
                                <input type="number" name="newViews" placeholder="+ Views" required
                                    class="bg-slate-800 text-white text-xs p-2 rounded-lg w-full border border-slate-700 focus:border-indigo-500 outline-none">
                                <input type="number" name="newLikes" placeholder="+ Likes" required
                                    class="bg-slate-800 text-white text-xs p-2 rounded-lg w-full border border-slate-700 focus:border-indigo-500 outline-none">
                                <button type="submit" class="bg-white hover:bg-slate-200 text-black text-[10px] font-black px-4 py-2 rounded-lg transition-transform active:scale-95">
                                    PUSH
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="text-center py-20 border-2 border-dashed border-slate-800 rounded-3xl">
                <p class="text-slate-500">No projects submitted yet.</p>
            </div>
        <% } %>
    </section>

    <!-- New Project Modal -->
    <div id="projectModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center z-50">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-lg p-8 rounded-3xl shadow-2xl">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-white">Register New Channel</h2>
                <button onclick="toggleModal()" class="text-slate-400 hover:text-white">&times;</button>
            </div>
        
            <form action="/creator/project/new" method="POST" class="space-y-5">
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Channel Name</label>
                    <input type="text" name="title" required placeholder="e.g. TechWithMani" 
                        class="w-full bg-slate-800 border-slate-700 text-white rounded-xl p-3 outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Channel Link (URL)</label>
                    <input type="url" name="link" required placeholder="https://youtube.com/..." 
                        class="w-full bg-slate-800 border-slate-700 text-white rounded-xl p-3 outline-none focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-slate-400 text-sm mb-2">Brief Description</label>
                    <textarea name="description" rows="3" 
                        class="w-full bg-slate-800 border-slate-700 text-white rounded-xl p-3 outline-none focus:border-indigo-500"></textarea>
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-all">
                    Create Channel
                </button>
            </form>
        </div>
    </div>
</div>