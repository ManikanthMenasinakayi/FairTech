<% layout('layouts/boilerplate') %>

<div class="min-h-[80vh] flex items-center justify-center">
    <div class="max-w-md w-full bg-slate-900 p-10 rounded-3xl border-2 border-red-500/20">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-white">Admin Terminal</h2>
            <p class="text-red-400 text-sm mt-2">Authorized Personnel Only</p>
        </div>

        <form action="/auth/admin/login" method="POST" class="space-y-6">
            <div>
                <label class="text-slate-300 text-sm">Admin Email</label>
                <input name="email" type="email" required class="w-full bg-slate-800 border-slate-700 text-white p-3 rounded-xl">
            </div>
            <div>
                <label class="text-slate-300 text-sm">Secret Password</label>
                <input name="password" type="password" required class="w-full bg-slate-800 border-slate-700 text-white p-3 rounded-xl">
            </div>
            <button class="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-all">
                Access Engine
            </button>
        </form>
    </div>
</div>