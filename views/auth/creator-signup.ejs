<% layout('layouts/boilerplate') %>

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-slate-900 p-10 rounded-3xl border border-slate-800 shadow-2xl">
        
        <!-- Header -->
        <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-indigo-500/10 rounded-xl flex items-center justify-center mb-4">
                <i class="fa-solid fa-wand-magic-sparkles text-indigo-500 text-xl"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-white">Join as a Creator</h2>
            <p class="mt-2 text-sm text-slate-400">
                Start earning fairly with manipulation-resistant tracking.
            </p>
        </div>

        <!-- Form -->
        <form class="mt-8 space-y-6" action="/auth/creator/signup" method="POST">
            <div class="space-y-4">
                <!-- Name Input -->
                <div>
                    <label for="name" class="block text-sm font-medium text-slate-300">Full Name</label>
                    <input id="name" name="name" type="text" required 
                        class="appearance-none relative block w-full px-4 py-3 mt-1 border border-slate-700 bg-slate-800 text-white rounded-xl placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent sm:text-sm" 
                        placeholder="Manikanth Menasinakayi">
                </div>

                <!-- Email Input -->
                <div>
                    <label for="email" class="block text-sm font-medium text-slate-300">Email Address</label>
                    <input id="email" name="email" type="email" required 
                        class="appearance-none relative block w-full px-4 py-3 mt-1 border border-slate-700 bg-slate-800 text-white rounded-xl placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent sm:text-sm" 
                        placeholder="creater@example.com">
                </div>

                <!-- Password Input -->
                <div>
                    <label for="password" class="block text-sm font-medium text-slate-300">Password</label>
                    <input id="password" name="password" type="password" required 
                        class="appearance-none relative block w-full px-4 py-3 mt-1 border border-slate-700 bg-slate-800 text-white rounded-xl placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent sm:text-sm" 
                        placeholder="••••••••">
                </div>
            </div>

            <!-- Trust Notice -->
            <div class="flex items-start bg-indigo-500/5 p-3 rounded-lg border border-indigo-500/10">
                <div class="flex-shrink-0">
                    <i class="fa-solid fa-shield-check text-indigo-400 text-sm mt-0.5"></i>
                </div>
                <div class="ml-3">
                    <p class="text-xs text-indigo-300">
                        By joining, you agree to our integrity policy. Your initial **Trust Score** will be 100%.
                    </p>
                </div>
            </div>

            <div>
                <button type="submit" 
                    class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all">
                    Create Creator Account
                </button>
            </div>
        </form>

        <div class="text-center text-sm">
            <p class="text-slate-500">
                Already have an account? 
                <a href="/auth/creator/login" class="font-medium text-indigo-400 hover:text-indigo-300 underline underline-offset-4">Sign in</a>
            </p>
        </div>
    </div>
</div>